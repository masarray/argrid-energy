{
  "name": "argrid-ems",
  "version": "1.0.0",
  "description": "Open-source industrial energy management system demonstration for GitHub Pages.",
  "license": "GPL-3.0-only",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run verify:build",
    "ci": "npm run check",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.168.23",
    "html2canvas-pro": "^2.3.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "keywords": [
